<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peng.zerocodeappsandbox.mapper.ChatHistoryMapper">

    <select id="selectByCursor" resultType="com.peng.zerocodeappsandbox.model.entity.ChatHistory">
        select id,
               message,
               messageType,
               appId,
               userId,
               createTime,
               updateTime,
               isDelete
        from chat_history
        where isDelete = 0
        <if test="appId != null">
            and appId = #{appId}
        </if>
        <if test="userId != null">
            and userId = #{userId}
        </if>
        <if test="messageType != null and messageType != ''">
            and messageType = #{messageType}
        </if>
        <if test="cursor != null and cursorId != null">
            and (createTime &lt; #{cursor} or (createTime = #{cursor} and id &lt; #{cursorId}))
        </if>
        <if test="cursor != null and cursorId == null">
            and createTime &lt; #{cursor}
        </if>
        order by createTime desc, id desc
        limit #{limit}
    </select>
</mapper>
